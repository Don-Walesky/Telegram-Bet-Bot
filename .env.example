# Telegram Bet Bot - Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO

# Telegram Bot token (optional in development; required in production)
# BOT_TOKEN=your_telegram_bot_token_here

# Local SQLite database path (optional; defaults to data/telegram_bet_bot.db)
# DATABASE_PATH=data/telegram_bet_bot.db
